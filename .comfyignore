# Left out of the Comfy Registry's copy (comfy node publish zips every tracked
# file less these): what a ComfyUI install never reads. The editor's built
# pages (seriesmith/server/static/, comfy_nodes/web/) and examples/ stay.
/tests/
/docs/
/tools/
/web/
/CLAUDE.md
/CONTRIBUTING.md
/.github/
# the script-writing skill's zip carries a copy of the build: it's installed from the repo
# (seriesmith.com links it), not from ComfyUI. prompts/SKILL.md stays: `seriesmith mcp` serves it.
/prompts/*.zip
# never meant to be tracked; listed in case a cache is committed again
/node_modules/
