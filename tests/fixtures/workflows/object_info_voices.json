    ],
    "comfy_usage_source": [
     "COMFY_USAGE_SOURCE"
    ],
    "unique_id": [
     "UNIQUE_ID"
    ]
   },
   "required": {
    "model": [
     "COMFY_DYNAMICCOMBO_V3",
     {
      "options": [
       {
        "inputs": {
         "required": {
          "normalize": [
           "BOOLEAN",
           {
            "default": true,
            "tooltip": "Normalize numbers and text for English and Chinese, improving stability for numbers and dates."
           }
          ],
          "speed": [
           "FLOAT",
           {
            "default": 1.0,
            "display": "slider",
            "max": 2.0,
