 "FishAudioTextToSpeech": {
  "api_node": true,
  "category": "partner/audio/Fish Audio",
  "deprecated": false,
  "description": "Convert text to speech. Supports emotion cues in the text ([happy], [whispering] on s2.1-pro; (happy) on s1), plain-language [directions] and `<whisper>...</whisper>` word tags on drama-3, and multi-speaker dialogue via @Voice1/@Voice2 tags with multiple connected voices.",
  "dev_only": false,
  "display_name": "Fish Audio Text to Speech",
  "essentials_category": null,
  "experimental": false,
  "has_intermediate_output": false,
