 "Drama3Generate": {
  "api_node": false,
  "category": "audio/drama3",
  "deprecated": false,
  "description": "Speak the text. Tags such as [sighs] or [laughs] go where the sound should be; <|speaker:N|> switches speakers, and the voice in slot voiceN speaks for speaker N.",
  "dev_only": false,
  "display_name": "Drama 3 Generate",
  "essentials_category": null,
  "experimental": false,
  "has_intermediate_output": false,
  "input": {
   "required": {
    "max_frames": [
     "INT",
     {
      "default": 600,
      "max": 8192,
      "min": 1,
      "tooltip": "At most this many frames per text chunk (21.5 per second of audio); generation ends earlier at end of speech."
     }
    ],
    "model": [
     "DRAMA3_MODEL",
     {}
    ],
    "seed": [
     "INT",
     {
      "control_after_generate": true,
      "default": 0,
      "max": 18446744073709551615,
      "min": 0
     }
    ],
    "speakers": [
     "COMBO",
     {
      "default": "one take per line",
      "multiselect": false,
      "options": [
       "one take per line",
       "one take per line, hearing the line before",
       "one take per speaker",
       "together"
      ],
      "tooltip": "one take per line: each line is generated on its own, with only its speaker's voices and earlier takes in the prompt, as Fish Audio's Drama 3 Space voices a scene; voices cannot bleed into each other, but lines do not hear each other. hearing the line before: the same plus the take before it as context, so lines react again but that take's voice can bleed in. one take per speaker: all of a speaker's lines in one take, cut at the line breaks it says and put back in script order. together: the dialogue as one script, every line hearing the others. Decode and the Editor decode each take on its own."
     }
    ],
    "split_long_text": [
     "BOOLEAN",
     {
      "default": true,
      "tooltip": "Generate long text in chunks of about 300 bytes, each continuing from the first and the latest chunk, as Fish Audio's own server does."
     }
    ],
    "temperature": [
     "FLOAT",
     {
      "default": 1.0,
      "max": 2.0,
      "min": 0.0,
      "step": 0.05,
      "tooltip": "1.0 with top_p 0.9 are the defaults of Fish Audio's Drama 3 server and Space; lower values make takes fall silent more often."
     }
    ],
    "text": [
     "STRING",
     {
      "multiline": true
     }
    ],
    "top_k": [
     "INT",
     {
      "default": 0,
      "max": 4096,
      "min": 0,
      "tooltip": "0 keeps every candidate, as Fish Audio's Drama 3 Space does: at a pause a few silence codes outrank the many ways speech resumes, and top_k 30 left 11 of their 40 takes silent."
     }
    ],
    "top_p": [
     "FLOAT",
     {
      "default": 0.9,
      "max": 1.0,
      "min": 0.05,
      "step": 0.05
     }
    ],
    "voices": [
     "COMFY_AUTOGROW_V3",
     {
      "template": {
       "input": {
        "required": {
         "voice": [
          "DRAMA3_VOICE",
          {}
         ]
        }
       },
       "max": 16,
       "min": 0,
       "prefix": "voice"
      }
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "model",
    "text",
    "voices",
    "seed",
    "temperature",
    "top_p",
    "top_k",
    "max_frames",
    "split_long_text",
    "speakers"
   ]
  },
  "is_input_list": false,
  "name": "Drama3Generate",
