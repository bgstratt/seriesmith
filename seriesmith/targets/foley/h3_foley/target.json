{
  "id": "h3_foley",
  "kind": "foley",
  "label": "MiniMax H3 FL2VA (effects from the picture)",
  "short": "H3 effects",
  "default_rank": 1,
  "code": "prompt.py",

  "capabilities": {
    "_note": "Video to sound: H3 FL2VA given the take's frames from frame 0 (MiniMaxH3AddGuide, an image batch) at a small size, asked for the sound of that video, only the sound decoded (VAEDecodeAudio: the picture never goes through the VAE). Measured 2026-11-01 (docs/SOUND.md 'H3 as video-to-audio'): 8-10 s a shot at 256x160 once loaded, and heard about as good as the LTX-2.3 Foley LoRA, which takes 60-120 s: the effects default. H3's own files (minimax_h3_fl2va's), under their terms.",
    "mode": "v2a",
    "fps": 24
  },

  "binding": {
    "_note": "The take goes up as a file (LoadVideo, its frames by GetVideoComponents: ComfyUI core, so any backend runs it); fx.stage first makes it the size and frame rate below, so nothing in the graph resizes. MiniMaxH3ImageToVideo at that size and the take's length, MiniMaxH3AddGuide at frame 0, BasicGuider, BasicScheduler 20 steps simple, res_multistep, VAEDecodeAudio on the audio VAE, SaveAudio (flac; converted to wav and fitted to the take's length when it comes back). Validated on local ComfyUI 0.43, 2026-11-01.",
    "workflow": "workflow.json",
    "workflow_name": "seriesmith_h3_foley.json",
    "env": "SERIESMITH_H3_FOLEY_WORKFLOW",
    "saver": {"class_type": "SaveAudio", "replace": {"class_type": "SaveAudio"}},
    "prune": true,
    "params": {
      "video": {"class_type": "LoadVideo", "field": "file"},
      "model": {"class_type": "UNETLoader", "field": "unet_name"},
      "text_encoder": {"class_type": "CLIPLoader", "field": "clip_name"},
      "video_vae": {"class_type": "VAELoader", "field": "vae_name", "title": "Video VAE"},
      "audio_vae": {"class_type": "VAELoader", "field": "vae_name", "title": "Audio VAE"},
      "prompt": {"class_type": "MiniMaxH3ImageToVideo", "field": "prompt"},
      "width": {"class_type": "MiniMaxH3ImageToVideo", "field": "width"},
      "height": {"class_type": "MiniMaxH3ImageToVideo", "field": "height"},
      "length": {"class_type": "MiniMaxH3ImageToVideo", "field": "length"},
      "steps": {"class_type": "BasicScheduler", "field": "steps"},
      "sampler": {"class_type": "KSamplerSelect", "field": "sampler_name"},
      "seed": {"class_type": "RandomNoise", "field": "noise_seed"}
    }
  },

  "models": {
    "model": {"family": "minimax-h3-fl2va", "patterns": ["*h3*fl2v*", "*fl2va*"], "tier": "required", "folder": "diffusion_models"},
    "text_encoder": {"family": "qwen3vl-32b", "patterns": ["*qwen3*vl*32b*"], "tier": "required", "folder": "text_encoders"},
    "video_vae": {"family": "minimax-h3-video-vae", "patterns": ["*h3*video*vae*"], "tier": "required", "folder": "vae"},
    "audio_vae": {"family": "minimax-h3-audio-vae", "patterns": ["*h3*audio*vae*"], "tier": "required", "folder": "vae"}
  },

  "nodes": {
    "_note": "ComfyUI core: the take's file and its frames.",
    "LoadVideo": {"tier": "required"},
    "GetVideoComponents": {"tier": "required"},
    "MiniMaxH3AddGuide": {"tier": "required"}
  },

  "presets": {
    "_note": "The measured settings: 256x160 (the small size heard as good as LTX-2.3; 512x288 took twice as long), 24 fps, 20 steps res_multistep with no turbo LoRA (the base branch of ComfyUI's H3 templates).",
    "final": {
      "model": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "steps": 20, "width": 256, "height": 160,
      "sampler": "res_multistep",
      "text_encoder": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "video_vae": "minimax_h3_video_vae_fp16.safetensors",
      "audio_vae": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },

  "downloads": {
    "_note": "The same files as minimax_h3_fl2va (ComfyUI template video_minimax_h3_i2v.json, properties.models).",
    "minimax_h3_fl2va_pruned_int8_convrot.safetensors": {"folder": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors", "source": "ComfyUI template video_minimax_h3_i2v.json (properties.models)"},
    "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors": {"folder": "text_encoders", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "source": "ComfyUI template video_minimax_h3_i2v.json (properties.models)"},
    "minimax_h3_video_vae_fp16.safetensors": {"folder": "vae", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_video_vae_fp16.safetensors", "source": "ComfyUI template video_minimax_h3_i2v.json (properties.models)"},
    "minimax_h3_audio_vae_fp32.safetensors": {"folder": "vae", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_audio_vae_fp32.safetensors", "source": "ComfyUI template video_minimax_h3_i2v.json (properties.models)"}
  }
}
