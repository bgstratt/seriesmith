{
  "id": "seedance_2_0_mini",
  "kind": "video",
  "label": "Seedance 2.0 Mini (hosted, Comfy Router)",
  "short": "Seedance",
  "code": "builtin:router_video",
  "capabilities": {
    "backends": [
      "router"
    ],
    "seed": "provider",
    "max_subjects": 9
  },
  "template": {
    "fps": 24,
    "frames": {
      "step": 24,
      "base": 96,
      "max": 360
    },
    "size_multiple": 2,
    "size_fit": "snap"
  },
  "recipe": {
    "policies": [
      "generate",
      "clone",
      "dub",
      "dub_keep_foley"
    ],
    "policy_fallback": {
      "to": "generate",
      "why": "Seedance makes its own sound"
    },
    "keyframes": [
      "first",
      "last"
    ],
    "keyframe_path": "refs/shots/{shot}/{end}.png",
    "prompt": "prose",
    "reference_image": {
      "sheet_panels": 4,
      "views": {
        "body": 0,
        "face": 3
      },
      "face_sizes": [
        "close",
        "cu",
        "mcu",
        "ecu"
      ],
      "plate": true,
      "_note": "The shot's subjects' sheets and its plate, sent as separate reference images (compile.py router_call), never composed into one picture as VACE's are."
    },
    "refs": {
      "character": {
        "kind": "character sheet",
        "shape": "sheet",
        "views": 4
      },
      "object": {
        "kind": "{kind} reference",
        "shape": "object"
      },
      "location": {
        "kind": "background plate",
        "shape": "plate"
      },
      "voice": {
        "kind": "voice sample",
        "shape": "voice"
      }
    },
    "size_hints": {
      "keyframe": "the render size, or any size of the same shape"
    },
    "_audio_note": "Seedance hears audio references (router.inputs.voices, role reference_audio): a clone shot sends each speaker's voice sample and names it in the prompt ('Use @Audio 1 as the voice of Ada.'); a dub shot sends its window of the recording ('Use @Audio 1 as the exact dialogue and soundtrack of the shot: the lips are synced to it.'). The wording follows BytePlus's @Image naming; not yet tried against the live service (docs/PLAN.md, 'Seedance audio references')."
  },
  "router": {
    "model": "byteplus/dreamina-seedance-2-0-mini",
    "arguments": {
      "output_format": "mp4",
      "watermark": false
    },
    "inputs": {
      "prompt": {
        "list": "content",
        "item": {
          "type": "text",
          "text": "$prompt"
        }
      },
      "references": {
        "list": "content",
        "item": {
          "type": "image_url",
          "image_url": {
            "url": "$url"
          },
          "role": "reference_image"
        },
        "max": 9,
        "max_total": 9,
        "define": true
      },
      "first": {
        "list": "content",
        "item": {
          "type": "image_url",
          "image_url": {
            "url": "$url"
          },
          "role": "first_frame"
        }
      },
      "last": {
        "list": "content",
        "item": {
          "type": "image_url",
          "image_url": {
            "url": "$url"
          },
          "role": "last_frame"
        }
      },
      "duration": {
        "name": "duration",
        "min": 4,
        "max": 15
      },
      "audio": {
        "name": "generate_audio"
      },
      "ratio": {
        "name": "ratio",
        "values": [
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16",
          "21:9",
          "9:21"
        ],
        "with_frames": "keep"
      },
      "resolution": {
        "name": "resolution",
        "values": [
          "480p",
          "720p"
        ]
      },
      "seed": {
        "name": "seed",
        "max": 2147483647
      },
      "via": "seedance",
      "voices": {
        "_note": "audio wav/mp3 2-15 s; up to 3 clips a request, and only with a picture",
        "list": "content",
        "item": {
          "type": "audio_url",
          "audio_url": {
            "url": "$url"
          },
          "role": "reference_audio"
        },
        "max": 3,
        "min_seconds": 2,
        "max_seconds": 15,
        "mention": "@Audio {n}",
        "via": "datauri",
        "with_frames": false,
        "_with_frames_note": "BytePlus: first/last frame content cannot be mixed with reference media content (refused as invalid_input, 2026-10-28): a shot sending audio goes by its reference pictures, not its keyframes",
        "_via_note": "inline as data:audio/wav;base64 (the schema's own form): the Seedance library registers pictures only and refused a wav as an image ('get image info ... This image format is not supported', 2026-10-28)",
        "needs_picture": true
      }
    },
    "picture_ratio": [
      0.4,
      2.5
    ]
  },
  "presets": {
    "final": {
      "model": "byteplus/dreamina-seedance-2-0-mini",
      "lora": null,
      "steps": 0,
      "width": 1280,
      "height": 720
    },
    "proxy": {
      "model": "byteplus/dreamina-seedance-2-0-mini",
      "lora": null,
      "steps": 0,
      "width": 854,
      "height": 480
    }
  },
  "multishot": {
    "_note": "A continuous: multishot group in prose: the look once, then a paragraph a shot, each a hard cut from the one before; the model times the cuts. Every shot's plate among the pictures.",
    "form": "prose",
    "plates": "all"
  },
  "draft": true
}
