{
  "id": "minimax_h3",
  "kind": "video",
  "label": "MiniMax H3 (hosted, Comfy Router)",
  "short": "MiniMax",
  "code": "builtin:router_video",
  "capabilities": {
    "backends": [
      "router"
    ],
    "seed": "provider",
    "max_subjects": 4
  },
  "template": {
    "fps": 24,
    "frames": {
      "step": 24,
      "base": 96,
      "max": 360
    },
    "size_multiple": 2,
    "size_fit": "snap"
  },
  "recipe": {
    "policies": [
      "generate"
    ],
    "policy_fallback": {
      "to": "generate",
      "why": "MiniMax makes its own sound and can't be given a recording to dub; lay the recording in at the edit"
    },
    "keyframes": [
      "first",
      "last"
    ],
    "keyframe_path": "refs/shots/{shot}/{end}.png",
    "prompt": "prose",
    "reference_image": {
      "sheet_panels": 4,
      "views": {
        "body": 0,
        "face": 3
      },
      "face_sizes": [
        "close",
        "cu",
        "mcu",
        "ecu"
      ],
      "plate": true,
      "_note": "The shot's subjects' sheets and its plate, sent as separate reference images (compile.py router_call), never composed into one picture as VACE's are."
    },
    "refs": {
      "character": {
        "kind": "character sheet",
        "shape": "sheet",
        "views": 4
      },
      "object": {
        "kind": "{kind} reference",
        "shape": "object"
      },
      "location": {
        "kind": "background plate",
        "shape": "plate"
      }
    },
    "size_hints": {
      "keyframe": "the render size, or any size of the same shape"
    }
  },
  "router": {
    "model": "minimax/minimax-h3",
    "arguments": {},
    "inputs": {
      "prompt": {
        "list": "content",
        "item": {
          "type": "text",
          "text": "$prompt"
        }
      },
      "references": {
        "list": "content",
        "item": {
          "type": "image_url",
          "image_url": {
            "url": "$url"
          },
          "role": "reference_image"
        }
      },
      "first": {
        "list": "content",
        "item": {
          "type": "image_url",
          "image_url": {
            "url": "$url"
          },
          "role": "first_frame"
        }
      },
      "last": {
        "list": "content",
        "item": {
          "type": "image_url",
          "image_url": {
            "url": "$url"
          },
          "role": "last_frame"
        }
      },
      "duration": {
        "name": "duration",
        "min": 4,
        "max": 15
      },
      "ratio": {
        "name": "ratio",
        "values": [
          "16:9",
          "9:16",
          "1:1"
        ]
      },
      "resolution": {
        "name": "resolution",
        "values": [
          "2K",
          "768P"
        ]
      },
      "seed": {
        "name": "seed",
        "max": 2147483647
      }
    }
  },
  "presets": {
    "final": {
      "model": "minimax/minimax-h3",
      "lora": null,
      "steps": 0,
      "width": 1366,
      "height": 768
    },
    "proxy": {
      "model": "minimax/minimax-h3",
      "lora": null,
      "steps": 0,
      "width": 1366,
      "height": 768
    }
  }
}
