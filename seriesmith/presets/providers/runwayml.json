{
  "id": "runwayml",
  "label": "Runway",
  "docs": "https://docs.dev.runwayml.com",
  "key_hint": "its key from dev.runwayml.com (key_...)",
  "base_url": "https://api.dev.runwayml.com",
  "auth": {
    "type": "bearer"
  },
  "headers": {
    "X-Runway-Version": "2024-11-06"
  },
  "parallel": 3,
  "untested": true,
  "endpoints": {
    "video": "image_to_video",
    "video_text": "text_to_video",
    "image": "text_to_image"
  },
  "files": {
    "via": "upload",
    "value": "$runway_uri",
    "steps": [
      {
        "method": "POST",
        "url": "/v1/uploads",
        "json": {
          "filename": "$name",
          "type": "ephemeral"
        },
        "take": {
          "put_to": "uploadUrl",
          "put_fields": "fields",
          "runway_uri": "runwayUri"
        }
      },
      {
        "method": "POST",
        "url": "$put_to",
        "key": false,
        "multipart": {
          "...": "$put_fields",
          "file": "$file"
        },
        "response": "none"
      }
    ]
  },
  "steps": [
    {
      "method": "POST",
      "url": "/v1/{endpoint}",
      "json": {
        "model": "$model",
        "...": "$args"
      },
      "take": {
        "task": "id"
      }
    },
    {
      "method": "GET",
      "url": "/v1/tasks/{task}",
      "until": {
        "status": "status",
        "done": [
          "SUCCEEDED"
        ],
        "failed": [
          "FAILED",
          "CANCELLED"
        ],
        "error": [
          "failure",
          "failureCode"
        ],
        "every": 5,
        "timeout": 3600
      }
    }
  ],
  "result": {
    "files": "output"
  },
  "cancel": {
    "method": "DELETE",
    "url": "/v1/tasks/{task}"
  },
  "check": "/v1/organization"
}
