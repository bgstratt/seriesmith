{
  "id": "atlas",
  "label": "Atlas Cloud",
  "untested": true,
  "docs": "https://www.atlascloud.ai/docs",
  "base_url": "https://api.atlascloud.ai/api/v1",
  "auth": {
    "type": "bearer"
  },
  "parallel": 3,
  "endpoints": {
    "video": "generateVideo",
    "image": "generateImage",
    "audio": "generateAudio"
  },
  "files": {
    "via": "upload",
    "value": "$url",
    "steps": [
      {
        "method": "POST",
        "url": "/model/uploadMedia",
        "multipart": {
          "file": "$file"
        },
        "take": {
          "url": [
            "url",
            "data.url"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "method": "POST",
      "url": "/model/{endpoint}",
      "json": {
        "model": "$model",
        "...": "$args"
      },
      "take": {
        "task": [
          "data.id",
          "id"
        ]
      }
    },
    {
      "method": "GET",
      "url": "/model/prediction/{task}",
      "until": {
        "status": "data.status",
        "done": [
          "completed"
        ],
        "failed": [
          "failed"
        ],
        "error": "data.error",
        "every": 5,
        "timeout": 3600
      }
    }
  ],
  "result": {
    "files": "data.outputs"
  }
}
