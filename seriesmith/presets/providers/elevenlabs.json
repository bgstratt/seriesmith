{
  "id": "elevenlabs",
  "label": "ElevenLabs",
  "untested": true,
  "docs": "https://elevenlabs.io/docs/api-reference",
  "base_url": "https://api.elevenlabs.io",
  "auth": {
    "type": "header",
    "name": "xi-api-key"
  },
  "parallel": 2,
  "steps": [
    {
      "method": "POST",
      "url": "/v1/text-to-speech/{voice}",
      "json": {
        "model_id": "$model",
        "...": "$args"
      },
      "response": "bytes"
    }
  ],
  "result": {
    "type": "audio"
  },
  "check": "/v1/models",
  "voices": {
    "url": "/v2/voices?page_size=100",
    "list": "voices",
    "id": "voice_id",
    "name": "name",
    "preview": "preview_url",
    "about": "description",
    "category": "category",
    "labels": "labels",
    "next": "next_page_token",
    "next_param": "next_page_token",
    "search_param": "search"
  }
}
