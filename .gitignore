# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Episode projects: series configs and scripts are yours, generated output is not
shotlist/
refs/
views/
renders/
renders_proxy/
refs_todo.md
refs_todo.json
refs_todo_proxy.md
refs_todo_proxy.json

# Media
*.mp4
*.wav
*.mp3
*.m4a
*.flac
*.png
*.jpg
*.jpeg
!examples/**/*.png
# the logo: the editor's icons (and the page built from them), the docs site's favicon
!web/src/brand/*.png
!seriesmith/server/static/assets/*.png
!docs/site/*.png
# the presets' sample pictures and camera clips (made by tools/make_preset_samples.py)
!seriesmith/presets/img/**/*.jpg
!seriesmith/presets/img/**/*.mp4
!seriesmith/presets/img/**/*.png

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Golden tests: the goldens are generated but committed on purpose. Real
# episodes used as fixtures stay local.
!tests/golden/**
tests/local/

# Claude Code agent worktrees
.claude/worktrees/

# Editor UI (web/): sources and the mock's media are committed, build junk isn't.
# The built editor (seriesmith/server/static/, comfy_nodes/web/) is committed on purpose.
web/node_modules/
web/dist-dev/
web/*.tsbuildinfo
!web/mock/media/**
